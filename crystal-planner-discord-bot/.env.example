# Discord bot token. Never commit the real token.
DISCORD_TOKEN=PUT_YOUR_DISCORD_BOT_TOKEN_HERE

# Optional. The systemd unit provides these paths automatically.
# CRYSTAL_PLANNER_CONFIG=/etc/crystal-planner/config.json
# CRYSTAL_PLANNER_STATE=/var/lib/crystal-planner/state.json

# debug | info | warn | error
LOG_LEVEL=info
